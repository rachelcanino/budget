<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Groceries">
<meta name="theme-color" content="#F3F7F4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0C1511" media="(prefers-color-scheme: dark)">
<title>Groceries</title>
<link rel="apple-touch-icon" id="touchIcon">
<link rel="icon" id="favIcon">
<style>
:root{--bg:#F3F7F4;--card:#FFFFFF;--soft:#EAF1EC;--text:#13221A;--muted:#5E7067;--border:#DDE8E1;--accent:#2E6B3B;--on-accent:#FFFFFF;--hero:#23522D;--hero-text:#FFFFFF;--tint:#E5EFE3;--tint-text:#23522D;--bar:#4E9A58;--ok:#2F7A3B;--warn:#A86E1B;--danger:#C8372D;--danger-bg:#FBE4E1}
@media (prefers-color-scheme:dark){:root{--bg:#0C1511;--card:#14201A;--soft:#1C2B23;--text:#E6F1EB;--muted:#92A79B;--border:#22352B;--accent:#7BC47F;--on-accent:#0E2410;--hero:#1E3A22;--hero-text:#E6F1EB;--tint:#1C3520;--tint-text:#A7D9A0;--bar:#7BC47F;--ok:#8FD18F;--warn:#F0B65A;--danger:#FF7D6E;--danger-bg:#3A1F1C}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--text);font:16px/1.45 -apple-system,system-ui,"Segoe UI",sans-serif}
header.top{position:sticky;top:0;z-index:5;background:var(--bg);padding:calc(env(safe-area-inset-top) + 12px) 16px 8px}
header.top h1{font-size:24px;font-weight:700;margin:0;letter-spacing:-.3px}
main{padding:6px 14px calc(92px + env(safe-area-inset-bottom))}
.tab[hidden]{display:none}
.panel{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:14px 16px;margin-bottom:12px}
h2{font-size:17px;font-weight:600;margin:2px 0 8px}
.hint{color:var(--muted);font-size:13px;margin:6px 0}
.t{display:block;font-size:12px;color:var(--muted);margin-bottom:4px}
input,textarea{width:100%;min-height:46px;padding:8px 12px;border:1px solid var(--border);border-radius:12px;background:var(--bg);color:var(--text);font:inherit;font-size:16px}
textarea{min-height:110px}
input[type=checkbox]{width:26px;height:26px;min-height:0;padding:0;accent-color:var(--accent);flex:none;margin:0}
input:disabled{opacity:.4}
button{min-height:44px;padding:0 16px;border:1px solid var(--border);border-radius:999px;background:var(--card);color:var(--text);font:inherit;font-size:15px;font-weight:500}
button.primary{background:var(--accent);color:var(--on-accent);border-color:var(--accent);font-weight:600}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.neg{color:var(--danger)}.pos{color:var(--ok)}.warn{color:var(--warn)}
.line{display:flex;justify-content:space-between;gap:12px;padding:4px 0;font-variant-numeric:tabular-nums}
.line span:first-child{color:var(--muted)}
.line.tot{border-top:1px solid var(--border);margin-top:6px;padding-top:8px;font-weight:600}
.line.tot span:first-child{color:var(--text)}
.nav{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;margin-bottom:12px}
.nav button{min-height:42px;width:42px;padding:0;font-size:20px}
.wklbl{text-align:center;font-weight:600}
.hero{background:var(--hero);color:var(--hero-text);border-radius:22px;padding:16px 18px;margin-bottom:12px}
.hero .lbl{font-size:13px;opacity:.85}
.hero .amt{font-size:34px;font-weight:700;letter-spacing:-.5px;margin:2px 0 4px;font-variant-numeric:tabular-nums}
.hero .hcs{display:flex;gap:8px;margin-top:12px}
.hero .hc{flex:1;background:rgba(255,255,255,.14);border-radius:14px;padding:8px 12px}
.hero .hc .k{font-size:12px;opacity:.85}
.hero .hc .v{font-size:16px;font-weight:600;font-variant-numeric:tabular-nums}
.hbar{height:9px;background:rgba(255,255,255,.2);border-radius:999px;overflow:hidden;margin-top:8px}
.hbar>div{height:100%;border-radius:999px}
.it{display:grid;grid-template-columns:auto 1fr 100px;gap:12px;align-items:center;padding:9px 0;border-bottom:1px solid var(--border)}
.it:last-child{border-bottom:0}
.it .nm{font-size:15px}
.it .up{font-size:12px;color:var(--muted)}
.it input[type=number]{min-height:40px;text-align:right}
.ex{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border);font-variant-numeric:tabular-nums}
.x{min-height:34px;width:34px;padding:0;flex:none}
.ed{display:grid;grid-template-columns:1fr 92px auto;gap:8px;align-items:center;margin-bottom:8px}
.wkrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);cursor:pointer}
.wkrow:last-child{border-bottom:0}
.tag{display:inline-block;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;white-space:nowrap;margin-top:2px}
.tag.pos{background:var(--tint);color:var(--tint-text)}.tag.neg{background:var(--danger-bg);color:var(--danger)}.tag.mid{background:var(--soft);color:var(--muted)}
table{width:100%;border-collapse:collapse;font-size:14px;font-variant-numeric:tabular-nums}
th{text-align:left;font-size:12px;color:var(--muted);font-weight:500;padding:4px 0}
td{padding:6px 0;border-top:1px solid var(--border)}
td.r,th.r{text-align:right}
